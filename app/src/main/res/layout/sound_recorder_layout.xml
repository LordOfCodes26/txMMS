<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.android.common.view.MBlurView
        android:id="@+id/glassBlurView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_background_transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/tx_dialog_padding_horizontal"
            android:paddingTop="@dimen/tx_dialog_padding_vertical">

            <TextView
                android:id="@+id/sound_rec_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/sound_recorder_while"
                android:textColor="@color/tx_title_text"
                android:textSize="@dimen/tx_dialog_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/sound_recorder_dialog_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/tx_dialog_padding">

                <ImageView
                    android:id="@+id/sound_recorder_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/sound_recorder_dialog_point" />

                <TextView
                    android:id="@+id/sound_recorder_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/sound_recorder_dialog_time_margin_left"
                    android:layout_marginEnd="@dimen/sound_recorder_dialog_time_margin_left"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tx_title_text"
                    android:textSize="@dimen/sound_recorder_dialog_time_size" />

                <ImageView
                    android:id="@+id/sound_recorder_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/sound_recorder_pause"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_pause" />
            </LinearLayout>

            <include
                layout="@layout/layout_confirm_tx_blur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.android.common.view.MBlurView>
</LinearLayout>
